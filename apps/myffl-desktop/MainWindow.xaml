<Window x:Class="MyFFL.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="myFFL" Height="720" Width="1180" MinHeight="640" MinWidth="980"
        Background="#05080F" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D1D5DB"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#08111F" Offset="0"/>
                <GradientStop Color="#05080F" Offset="0.45"/>
                <GradientStop Color="#1B0B12" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#07101D" BorderBrush="#1F2937" BorderThickness="0,0,1,0" Padding="22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock FontSize="36" FontWeight="Black" FontStyle="Italic" Foreground="#FFFFFF">
                        <Run Text="my"/>
                        <Run Text="FFL" Foreground="#DC2626"/>
                    </TextBlock>
                    <TextBlock Text="Desktop Command Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,28"/>
                    <Button Style="{StaticResource NavButton}" Content="Home"/>
                    <Button Style="{StaticResource NavButton}" Content="Leagues"/>
                    <Button Style="{StaticResource NavButton}" Content="My Team"/>
                    <Button Style="{StaticResource NavButton}" Content="Players"/>
                    <Button Style="{StaticResource NavButton}" Content="Matchups"/>
                    <Button Style="{StaticResource NavButton}" Content="Draft"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="#1D4ED8" BorderThickness="1" Padding="12" Background="#0B1220">
                    <StackPanel>
                        <TextBlock Text="API" Foreground="#60A5FA" FontWeight="Bold"/>
                        <TextBlock Text="http://localhost:8787" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="28">
            <StackPanel>
                <TextBlock Text="Phase 1" Foreground="#60A5FA" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Build the league before the season starts." Foreground="#FFFFFF"
                           FontSize="38" FontWeight="Bold" Margin="0,8,0,10"/>
                <TextBlock Text="Registration, login, league creation, scoring, and gameday views will come online phase by phase."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="16" Width="690" HorizontalAlignment="Left"
                           TextWrapping="Wrap" Margin="0,0,0,26"/>

                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,18">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Cloudflare" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="D1, R2, Queues, Pages, Email" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Available" Foreground="#22C55E" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Authentication" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="Register and login API shell" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="In progress" Foreground="#60A5FA" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="League Hub" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="Commissioner controls next" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Planned" Foreground="#D1D5DB" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="#0B1220" BorderBrush="#334155" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Implementation Status" Foreground="#FFFFFF" FontWeight="Bold" FontSize="20"/>
                        <TextBlock Text="This shell is intentionally runnable while deeper fantasy workflows are built behind the same API contracts."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <StackPanel>
                            <TextBlock Text="- Registration and login endpoints: in progress" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="- League management: planned for Phase 2" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="- Custom scoring editor: planned for Phase 3" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="- ESPN synchronization: planned for Phase 4" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
