<Window x:Class="MyFFL.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="myFFL Desktop" Height="820" Width="1440" MinHeight="680" MinWidth="1080" WindowState="Maximized"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown"
        Background="#05080F" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#09111D"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="Muted" Color="#AAB4C3"/>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#101925"/><Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="39"/><Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="13,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#14223A"/><Setter Property="BorderBrush" Value="#1D4ED8"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DockColumn" Width="0"/></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#070D16" BorderBrush="#243247" BorderThickness="0,0,0,1">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="27" FontWeight="Black" FontStyle="Italic" Foreground="White"><Run Text="my"/><Run Text="FFL" Foreground="#EF233C"/></TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Alt+Left)" Click="Back_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" Click="Forward_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh (F5)" Click="Refresh_Click"/>
                    <TextBlock x:Name="PageTitle" Text="League command center" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Print or export report (Ctrl+P)" Click="Print_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7C4;" ToolTip="Open in browser" Click="OpenExternal_Click"/>
                    <Button x:Name="DockButton" Style="{StaticResource IconButton}" Content="&#xE90C;" ToolTip="Toggle matchup dock (Ctrl+Shift+M)" Click="ToggleDock_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#07101D" BorderBrush="#243247" BorderThickness="0,0,1,0" Padding="14,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WORKSPACE" Foreground="#6EA8FE" FontSize="10" FontWeight="Bold" Margin="10,0,0,10"/>
                    <Button Style="{StaticResource NavButton}" Content="Home" Tag="home" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="My Team" Tag="team" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Matchup" Tag="gameday" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Players" Tag="players" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Transactions" Tag="transactions" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="League" Tag="overview" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Draft" Tag="draft" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Chat" Tag="chat" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Standings &amp; Schedule" Tag="gameday" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Scoring" Tag="scoring" Click="Navigate_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Settings" Tag="settings" Click="Navigate_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#0B1625" BorderBrush="#334155" BorderThickness="1" Padding="10">
                    <StackPanel><TextBlock Text="CONNECTION" Foreground="#6EA8FE" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="ApiStatusText" Text="Starting..." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#05080F">
            <wv2:WebView2 x:Name="MainWebView" DefaultBackgroundColor="#05080F"/>
        </Border>

        <GridSplitter x:Name="DockSplitter" Grid.Row="1" Grid.Column="2" Width="5" HorizontalAlignment="Left" Background="#1D4ED8" Visibility="Collapsed"/>
        <Border x:Name="DockPanel" Grid.Row="1" Grid.Column="2" Margin="5,0,0,0" Background="#070D16" BorderBrush="#334155" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="12,0"><TextBlock Text="LIVE MATCHUP" Foreground="#6EA8FE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close matchup dock" Click="ToggleDock_Click"/></DockPanel>
                <wv2:WebView2 x:Name="MatchupWebView" Grid.Row="1" DefaultBackgroundColor="#05080F"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#070D16" BorderBrush="#243247" BorderThickness="0,1,0,0">
            <Grid Margin="12,0"><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#718096" FontSize="10" Text="Ctrl+1 Home   Ctrl+2 Team   Ctrl+3 Matchup   Ctrl+D Draft   Ctrl+Shift+M Dock"/></Grid>
        </Border>
    </Grid>
</Window>
