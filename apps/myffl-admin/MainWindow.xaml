<Window x:Class="MyFFL.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="myFFL Admin" Height="860" Width="1480" MinHeight="720" MinWidth="1180"
        Background="#05080F" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#101823"/>
        <SolidColorBrush x:Key="Border" Color="#374151"/>
        <SolidColorBrush x:Key="Muted" Color="#AAB6C5"/>
        <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#1D4ED8"/><Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="Padding" Value="13,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#07101D"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#07101D"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#07101D"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#07101D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#374151"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowBackground" Value="#07101D"/><Setter Property="AlternatingRowBackground" Value="#0D1725"/><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="#D1D5DB"/><Setter Property="Background" Value="#111827"/><Setter Property="BorderBrush" Value="#374151"/><Setter Property="Padding" Value="8,6"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1F2937"/><Setter Property="Padding" Value="6,4"/></Style>
        <Style TargetType="TabControl"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#05080F"/><Setter Property="BorderBrush" Value="#374151"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#D1D5DB"/><Setter Property="Background" Value="#111827"/><Setter Property="BorderBrush" Value="#374151"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#1D4ED8"/><Setter Property="BorderBrush" Value="#3B82F6"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#07101D" BorderBrush="#273244" BorderThickness="0,0,0,1" Padding="24,0">
            <DockPanel><TextBlock VerticalAlignment="Center" FontSize="29" FontWeight="Black" FontStyle="Italic" Foreground="White"><Run Text="my"/><Run Text="FFL" Foreground="#DC2626"/><Run Text=" Admin" Foreground="#D1D5DB"/></TextBlock><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ConnectionIndicator" Width="9" Height="9" Fill="#64748B" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="Signed out" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><StackPanel>
                <GroupBox Header="Administrator Sign In"><StackPanel><TextBlock Text="API address" Foreground="{StaticResource Muted}"/><TextBox x:Name="ApiUrlTextBox" Text="https://api.myfflapp.com"/><TextBlock Text="Email" Foreground="{StaticResource Muted}"/><TextBox x:Name="EmailTextBox"/><TextBlock Text="Password" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="PasswordInput"/><Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click"/></StackPanel></GroupBox>
                <GroupBox Header="Provider Sync"><WrapPanel x:Name="ProviderControls" IsEnabled="False"><Button Content="Scoreboard" Tag="scoreboard" Click="Sync_Click"/><Button Content="Teams" Tag="teams" Click="Sync_Click"/><Button Content="Injuries" Tag="injuries" Click="Sync_Click" Background="#B91C1C"/><Button Content="Refresh all" Click="Refresh_Click" Background="#273449"/></WrapPanel></GroupBox>
                <GroupBox Header="Test Mode"><StackPanel x:Name="SimulationControls" IsEnabled="False"><CheckBox x:Name="ReplayModeToggle" Content="Route app to replay data" Foreground="White" Margin="0,0,0,10" Checked="ReplayMode_Checked" Unchecked="ReplayMode_Unchecked"/><TextBlock x:Name="ProviderModeText" Text="Live ESPN data active" Foreground="#72D49A" Margin="0,0,0,10"/><ComboBox x:Name="SpeedCombo" SelectedIndex="0"><ComboBoxItem Content="1x" Tag="1"/><ComboBoxItem Content="2x" Tag="2"/><ComboBoxItem Content="4x" Tag="4"/></ComboBox><Button Content="Start new test run" Click="CreateSimulation_Click"/><WrapPanel><Button Content="Play" Click="SimulationAction_Click" Tag="play"/><Button Content="Pause" Click="SimulationAction_Click" Tag="pause" Background="#273449"/><Button Content="Step" Click="SimulationAction_Click" Tag="step"/><Button Content="Reset" Click="SimulationAction_Click" Tag="reset" Background="#273449"/><Button Content="Stop" Click="SimulationAction_Click" Tag="stop" Background="#B91C1C"/></WrapPanel></StackPanel></GroupBox>
            </StackPanel></ScrollViewer>
            <TabControl Grid.Column="2" x:Name="AdminTabs">
                <TabItem Header="Dashboard"><ScrollViewer><StackPanel Margin="14"><TextBlock Text="Platform Operations" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Authoritative account, league, provider, and job status" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/><UniformGrid Columns="4" Margin="0,0,0,14"><Border Background="{StaticResource Panel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Active users" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ActiveUsersCount" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Active leagues" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ActiveLeaguesCount" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Live NFL games" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LiveGamesCount" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="14"><StackPanel><TextBlock Text="Failed requests (24h)" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FailedRequestsCount" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/></StackPanel></Border></UniformGrid><GroupBox Header="Provider Health"><DataGrid x:Name="DashboardProviderGrid" Height="180"/></GroupBox><GroupBox Header="Recent Admin Activity"><DataGrid x:Name="DashboardActivityGrid" Height="300"/></GroupBox></StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Users"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="Search" Click="SearchUsers_Click"/><TextBox x:Name="UserSearchText" ToolTip="Search users"/></DockPanel><DataGrid Grid.Row="1" x:Name="UsersGrid" SelectionChanged="UsersGrid_SelectionChanged"/><WrapPanel Grid.Row="2" Margin="0,10,0,2"><TextBox x:Name="UserReasonText" Width="250" ToolTip="Required reason"/><Button Content="Lock" Click="UserAction_Click" Tag="disabled" Background="#B91C1C"/><Button Content="Unlock" Click="UserAction_Click" Tag="active"/><Button Content="Revoke sessions" Click="RevokeSessions_Click" Background="#273449"/><ComboBox x:Name="AdminRoleCombo" Width="125" SelectedIndex="0"><ComboBoxItem Content="No role" Tag=""/><ComboBoxItem Content="Support" Tag="support"/><ComboBoxItem Content="Operator" Tag="operator"/><ComboBoxItem Content="Owner" Tag="owner"/></ComboBox><Button Content="Set role" Click="SetRole_Click"/></WrapPanel><TabControl Grid.Row="3"><TabItem Header="Account"><TextBox x:Name="UserDetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Leagues"><DataGrid x:Name="UserLeaguesGrid"/></TabItem><TabItem Header="Login History"><DataGrid x:Name="LoginHistoryGrid"/></TabItem><TabItem Header="Devices"><DataGrid x:Name="UserDevicesGrid"/></TabItem></TabControl></Grid></TabItem>
                <TabItem Header="Leagues"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="210"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="Search" Click="SearchLeagues_Click"/><TextBox x:Name="LeagueSearchText"/></DockPanel><DataGrid Grid.Row="1" x:Name="LeaguesGrid" SelectionChanged="LeaguesGrid_SelectionChanged"/><WrapPanel Grid.Row="2" Margin="0,10,0,2"><TextBox x:Name="LeagueReasonText" Width="250" ToolTip="Required reason"/><TextBox x:Name="RecalculateWeeksText" Width="120" Text="1" ToolTip="Weeks, comma separated"/><Button Content="Archive" Tag="archive" Click="LeagueAction_Click" Background="#B91C1C"/><Button Content="Restore" Tag="restore" Click="LeagueAction_Click"/><Button Content="Recalculate" Click="RecalculateLeague_Click"/></WrapPanel><TabControl Grid.Row="3"><TabItem Header="Settings"><DataGrid x:Name="LeagueSettingsGrid"/></TabItem><TabItem Header="Members"><DataGrid x:Name="LeagueMembersGrid"/></TabItem><TabItem Header="Teams"><DataGrid x:Name="LeagueTeamsGrid"/></TabItem><TabItem Header="Scoring"><DataGrid x:Name="LeagueScoringGrid"/></TabItem><TabItem Header="Transactions"><DataGrid x:Name="LeagueTransactionsGrid"/></TabItem><TabItem Header="Matchups"><DataGrid x:Name="LeagueMatchupsGrid"/></TabItem><TabItem Header="Audit"><DataGrid x:Name="LeagueAuditGrid"/></TabItem></TabControl></Grid></TabItem>
                <TabItem Header="Players"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="210"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="Search" Click="SearchPlayers_Click"/><TextBox x:Name="PlayerSearchText"/></DockPanel><DataGrid Grid.Row="1" x:Name="AdminPlayersGrid" SelectionChanged="AdminPlayersGrid_SelectionChanged"/><WrapPanel Grid.Row="2" Margin="0,10,0,2"><TextBox x:Name="PlayerPositionText" Width="70" ToolTip="Position"/><TextBox x:Name="PlayerTeamText" Width="120" ToolTip="Internal team ID"/><TextBox x:Name="PlayerProviderIdText" Width="130" ToolTip="ESPN player ID"/><TextBox x:Name="PlayerAliasText" Width="130" ToolTip="Alias"/><TextBox x:Name="PlayerReasonText" Width="180" ToolTip="Required reason"/><Button Content="Save mapping" Click="SavePlayerMapping_Click"/><TextBox x:Name="MergeTargetText" Width="160" ToolTip="Target player ID"/><Button Content="Merge duplicate" Click="MergePlayer_Click" Background="#B91C1C"/></WrapPanel><TabControl Grid.Row="3"><TabItem Header="Profile"><TextBox x:Name="PlayerDetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Mappings"><DataGrid x:Name="PlayerMappingsGrid"/></TabItem><TabItem Header="Aliases"><DataGrid x:Name="PlayerAliasesGrid"/></TabItem><TabItem Header="Injuries"><DataGrid x:Name="PlayerInjuriesGrid"/></TabItem><TabItem Header="Normalized Stats"><DataGrid x:Name="PlayerStatsGrid"/></TabItem></TabControl></Grid></TabItem>
                <TabItem Header="NFL Events"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/></Grid.RowDefinitions><WrapPanel><TextBox x:Name="EventWeekText" Width="100" Text="0" ToolTip="Week (0 for all)"/><Button Content="Load events" Click="LoadEvents_Click"/></WrapPanel><DataGrid Grid.Row="1" x:Name="EventsGrid" SelectionChanged="EventsGrid_SelectionChanged"/><WrapPanel Grid.Row="2" Margin="0,10,0,2"><TextBox x:Name="EventReasonText" Width="260" ToolTip="Required reason"/><Button Content="Sync" Tag="sync" Click="EventAction_Click"/><Button Content="Reprocess" Tag="reprocess" Click="EventAction_Click"/><Button Content="Mark final" Tag="mark-final" Click="EventAction_Click"/><Button Content="Reopen" Tag="reopen" Click="EventAction_Click" Background="#B91C1C"/></WrapPanel><TabControl Grid.Row="3"><TabItem Header="Event"><TextBox x:Name="EventDetailText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Players"><DataGrid x:Name="EventPlayersGrid"/></TabItem><TabItem Header="Plays"><DataGrid x:Name="EventPlaysGrid"/></TabItem><TabItem Header="Raw Archives"><DataGrid x:Name="EventArchivesGrid"/></TabItem><TabItem Header="Actions"><DataGrid x:Name="EventActionsGrid"/></TabItem></TabControl></Grid></TabItem>
                <TabItem Header="Scoring Investigation"><ScrollViewer><StackPanel Margin="14"><TextBlock Text="Score Lineage and Correction" Foreground="White" FontSize="26" FontWeight="Bold"/><WrapPanel Margin="0,12,0,4"><TextBox x:Name="ScoreLeagueIdText" Width="190" ToolTip="League ID"/><TextBox x:Name="ScoreSeasonIdText" Width="190" ToolTip="Season ID"/><TextBox x:Name="ScoreEventIdText" Width="190" ToolTip="NFL event ID"/><TextBox x:Name="ScorePlayerIdText" Width="190" ToolTip="NFL player ID"/><TextBox x:Name="ScoreScopeText" Width="120" Text="production"/><Button Content="Investigate" Click="InvestigateScore_Click"/></WrapPanel><UniformGrid Columns="2"><GroupBox Header="Raw and Normalized Data" Margin="0,0,8,12"><TextBox x:Name="ScoreRawText" Height="190" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></GroupBox><GroupBox Header="Authoritative Score"><TextBox x:Name="ScoreSummaryText" Height="190" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></GroupBox></UniformGrid><GroupBox Header="Applied Components"><DataGrid x:Name="ScoreComponentsGrid" Height="190"/></GroupBox><GroupBox Header="Revision History"><DataGrid x:Name="ScoreRevisionsGrid" Height="190"/></GroupBox><WrapPanel><TextBox x:Name="CorrectedPointsText" Width="120" ToolTip="Corrected points"/><TextBox x:Name="CorrectionReasonText" Width="300" ToolTip="Required reason"/><Button Content="Preview correction" Click="PreviewCorrection_Click"/><Button Content="Apply preview" Click="ApplyCorrection_Click" Background="#B91C1C"/><TextBox x:Name="CorrectionIdText" Width="220" ToolTip="Correction ID to revert"/><Button Content="Revert correction" Click="RevertCorrection_Click" Background="#273449"/></WrapPanel><TextBox x:Name="CorrectionPreviewText" MinHeight="100" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Monitoring"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions><Button Content="Refresh monitoring" Click="RefreshMonitoring_Click" HorizontalAlignment="Left"/><DataGrid Grid.Row="1" x:Name="ResourcesGrid"/><TabControl Grid.Row="2"><TabItem Header="Shards"><DataGrid x:Name="ShardsGrid"/></TabItem><TabItem Header="Jobs"><DataGrid x:Name="JobsGrid"/></TabItem><TabItem Header="Scoring Receipts"><DataGrid x:Name="ReceiptsGrid"/></TabItem><TabItem Header="Global Audit"><DataGrid x:Name="GlobalAuditGrid"/></TabItem></TabControl></Grid></TabItem>
                <TabItem Header="Provider Credentials"><ScrollViewer><StackPanel Margin="14" MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Provider Credentials" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="FantasyPros Expert Consensus Rankings" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/><UniformGrid Columns="4" Margin="0,0,0,14"><Border Background="{StaticResource Panel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Status" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FantasyProsConfiguredText" Text="Not configured" FontSize="18" FontWeight="Bold" Foreground="White"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Stored key" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FantasyProsMaskedKeyText" Text="-" FontSize="18" FontWeight="Bold" Foreground="White"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Requests today" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FantasyProsUsageText" Text="0 / 8" FontSize="18" FontWeight="Bold" Foreground="White"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="14"><StackPanel><TextBlock Text="Last validation" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FantasyProsValidatedText" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid><GroupBox Header="FantasyPros CSV Import"><StackPanel><WrapPanel><TextBox x:Name="FantasyProsCsvSeasonText" Width="90" Text="2026" ToolTip="Season year"/><ComboBox x:Name="FantasyProsCsvScoringCombo" Width="90" SelectedIndex="2"><ComboBoxItem Content="STD"/><ComboBoxItem Content="HALF"/><ComboBoxItem Content="PPR"/></ComboBox><TextBox x:Name="FantasyProsCsvScopeText" Width="120" Text="OVERALL" ToolTip="OVERALL, QB, RB, WR, TE, K, DST, IDP"/><TextBox x:Name="FantasyProsCsvReasonText" Width="260" ToolTip="Required reason"/></WrapPanel><TextBox x:Name="FantasyProsCsvText" MinHeight="150" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" ToolTip="Paste FantasyPros CSV content here"/><WrapPanel><Button Content="Import pasted CSV" Click="ImportFantasyProsCsv_Click"/><Button Content="Clear CSV" Click="ClearFantasyProsCsv_Click" Background="#273449"/></WrapPanel><TextBlock x:Name="FantasyProsCsvResultText" Text="Paste a FantasyPros CSV export, choose scoring/scope, then import." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="FantasyPros API"><StackPanel><TextBlock Text="Replacement API key" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="FantasyProsApiKeyInput" Width="560" HorizontalAlignment="Left"/><CheckBox x:Name="FantasyProsEnabledToggle" Content="Enable scheduled rankings" Foreground="White" Margin="0,4,0,10"/><TextBlock Text="Audit reason" Foreground="{StaticResource Muted}"/><TextBox x:Name="FantasyProsReasonText" Width="560" HorizontalAlignment="Left"/><WrapPanel><Button Content="Save settings" Click="SaveFantasyProsCredential_Click"/><Button Content="Refresh rankings now" Click="SyncFantasyPros_Click" Background="#273449"/><Button Content="Reload status" Click="RefreshFantasyPros_Click" Background="#273449"/></WrapPanel><TextBlock x:Name="FantasyProsStorageText" Text="No credential stored" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></GroupBox><GroupBox Header="Request Ledger"><DataGrid x:Name="FantasyProsRunsGrid" Height="330"/></GroupBox></StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Provider Replay"><ScrollViewer><StackPanel Margin="14"><TextBlock Text="Provider Replay" Foreground="White" FontSize="28" FontWeight="Bold"/><UniformGrid Columns="4" Margin="0,12,0,12"><Border Background="{StaticResource Panel}" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Teams" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TeamsCount" Text="-" Foreground="White" FontSize="22"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Players" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PlayersCount" Text="-" Foreground="White" FontSize="22"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Events" Foreground="{StaticResource Muted}"/><TextBlock x:Name="EventsCount" Text="-" Foreground="White" FontSize="22"/></StackPanel></Border><Border Background="{StaticResource Panel}" Padding="12"><StackPanel><TextBlock Text="Raw archives" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ArchivesCount" Text="-" Foreground="White" FontSize="22"/></StackPanel></Border></UniformGrid><GroupBox Header="Current Test Run"><StackPanel><TextBlock x:Name="SimulationStatusText" Text="No test run loaded." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontFamily="Consolas"/><ProgressBar x:Name="SimulationProgress" Height="6" Minimum="0" Maximum="1" Margin="0,10,0,8"/><TextBlock x:Name="CurrentPlayText" Text="Waiting for kickoff." Foreground="White" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="Game Progress"><DataGrid x:Name="GamesGrid" Height="130"/></GroupBox><GroupBox Header="Player Statistics"><DataGrid x:Name="PlayersGrid" Height="180"/></GroupBox><GroupBox Header="Play Timeline"><DataGrid x:Name="PlaysGrid" Height="230"/></GroupBox><GroupBox Header="Provider Activity"><TextBox x:Name="ActivityText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="170" FontFamily="Consolas"/></GroupBox></StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" Background="#07101D" BorderBrush="#273244" BorderThickness="0,1,0,0" Padding="14,0"><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Border>
    </Grid>
</Window>
