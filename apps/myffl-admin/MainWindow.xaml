<Window x:Class="MyFFL.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="myFFL Admin" Height="780" Width="1220" MinHeight="680" MinWidth="1040"
        Background="#05080F" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#101823"/>
        <SolidColorBrush x:Key="Border" Color="#374151"/>
        <SolidColorBrush x:Key="Muted" Color="#AAB6C5"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/><Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#07101D"/>
            <Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#07101D"/>
            <Setter Property="BorderBrush" Value="#475569"/><Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#07101D" BorderBrush="#273244" BorderThickness="0,0,0,1" Padding="24,0">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontSize="29" FontWeight="Black" FontStyle="Italic" Foreground="White">
                    <Run Text="my"/><Run Text="FFL" Foreground="#DC2626"/><Run Text=" Admin" Foreground="#D1D5DB"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionIndicator" Width="9" Height="9" Fill="#64748B" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ConnectionText" Text="Signed out" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <GroupBox Header="Administrator Sign In">
                    <StackPanel>
                        <TextBlock Text="API address" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="ApiUrlTextBox" Text="https://api.myfflapp.com" Margin="0,0,0,12"/>
                        <TextBlock Text="Email" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="EmailTextBox" Margin="0,0,0,12"/>
                        <TextBlock Text="Password" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,14"/>
                        <Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Provider Sync">
                    <WrapPanel x:Name="ProviderControls" IsEnabled="False">
                        <Button Content="Scoreboard" Tag="scoreboard" Click="Sync_Click"/>
                        <Button Content="Teams" Tag="teams" Click="Sync_Click"/>
                        <Button Content="Injuries" Tag="injuries" Click="Sync_Click" Background="#B91C1C" BorderBrush="#EF4444"/>
                        <Button Content="Refresh" Click="Refresh_Click" Background="#273449" BorderBrush="#64748B"/>
                    </WrapPanel>
                </GroupBox>
                <GroupBox Header="Test Mode">
                    <StackPanel x:Name="SimulationControls" IsEnabled="False">
                        <CheckBox x:Name="ReplayModeToggle" Content="Route Game Center to replay data" Foreground="White" Margin="0,0,0,12" Checked="ReplayMode_Checked" Unchecked="ReplayMode_Unchecked"/>
                        <TextBlock x:Name="ProviderModeText" Text="Live ESPN data active" Foreground="#72D49A" Margin="0,0,0,12"/>
                        <DockPanel Margin="0,0,0,10"><TextBlock Text="Speed" Foreground="{StaticResource Muted}"/><ComboBox x:Name="SpeedCombo" DockPanel.Dock="Right" Width="90" SelectedIndex="0"><ComboBoxItem Content="1x" Tag="1"/><ComboBoxItem Content="2x" Tag="2"/><ComboBoxItem Content="4x" Tag="4"/></ComboBox></DockPanel>
                        <Button Content="Start new test run" Click="CreateSimulation_Click"/>
                        <WrapPanel>
                            <Button Content="Play" Click="SimulationAction_Click" Tag="play"/>
                            <Button Content="Pause" Click="SimulationAction_Click" Tag="pause" Background="#273449" BorderBrush="#64748B"/>
                            <Button Content="Step" Click="SimulationAction_Click" Tag="step"/>
                            <Button Content="Reset" Click="SimulationAction_Click" Tag="reset" Background="#273449" BorderBrush="#64748B"/>
                            <Button Content="Stop" Click="SimulationAction_Click" Tag="stop" Background="#B91C1C" BorderBrush="#EF4444"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Provider Operations" Foreground="White" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="ESPN ingestion health and isolated game replay" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,5,0,18"/>
                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Teams" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TeamsCount" Text="-" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Players" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PlayersCount" Text="-" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Events" Foreground="{StaticResource Muted}"/><TextBlock x:Name="EventsCount" Text="-" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="Raw archives" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ArchivesCount" Text="-" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
                    </UniformGrid>
                    <GroupBox Header="Current Test Run"><StackPanel><TextBlock x:Name="SimulationStatusText" Text="No test run loaded." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontFamily="Consolas"/><ProgressBar x:Name="SimulationProgress" Height="6" Minimum="0" Maximum="1" Value="0" Margin="0,12,0,8" Foreground="#2563EB"/><TextBlock x:Name="CurrentPlayText" Text="Waiting for kickoff." Foreground="White" TextWrapping="Wrap"/></StackPanel></GroupBox>
                    <GroupBox Header="Game Progress"><DataGrid x:Name="GamesGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="#07101D" Foreground="White" BorderThickness="0" MinHeight="120"/></GroupBox>
                    <GroupBox Header="Player Statistics"><DataGrid x:Name="PlayersGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="#07101D" Foreground="White" BorderThickness="0" MinHeight="150"/></GroupBox>
                    <GroupBox Header="Play Timeline"><DataGrid x:Name="PlaysGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="#07101D" Foreground="White" BorderThickness="0" MinHeight="190"/></GroupBox>
                    <GroupBox Header="Provider Activity"><TextBox x:Name="ActivityText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="170" FontFamily="Consolas"/></GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="#07101D" BorderBrush="#273244" BorderThickness="0,1,0,0" Padding="14,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
