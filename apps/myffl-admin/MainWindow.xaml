<Window x:Class="MyFFL.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="myFFL Admin" Height="720" Width="1180" MinHeight="640" MinWidth="980"
        Background="#05080F" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#D1D5DB"/>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#05080F" Offset="0"/>
                <GradientStop Color="#111827" Offset="0.55"/>
                <GradientStop Color="#220A0A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#07101D" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="24,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="30" FontWeight="Black" FontStyle="Italic" Foreground="#FFFFFF">
                    <Run Text="my"/>
                    <Run Text="FFL" Foreground="#DC2626"/>
                    <Run Text=" Admin" Foreground="#D1D5DB"/>
                </TextBlock>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="#2A1115" BorderBrush="#DC2626" BorderThickness="1" Padding="12,7">
                    <TextBlock Text="Restricted Utility" Foreground="#FFFFFF" FontWeight="Bold"/>
                </Border>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="28">
            <StackPanel>
                <TextBlock Text="Platform Operations" Foreground="#FFFFFF" FontSize="36" FontWeight="Bold"/>
                <TextBlock Text="Admin tools will inspect provider data, scoring changes, failed jobs, and audit trails."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="16" TextWrapping="Wrap" Width="760"
                           HorizontalAlignment="Left" Margin="0,8,0,24"/>

                <UniformGrid Columns="3" Rows="2">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Users" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="Account and session investigation" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Phase 11" Foreground="#D1D5DB" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Provider Data" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="ESPN raw archive inspection" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Phase 4" Foreground="#D1D5DB" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Scoring" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="Preview, apply, and audit corrections" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Phase 11" Foreground="#D1D5DB" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Jobs" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="Queues, workflows, and retries" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Planned" Foreground="#D1D5DB" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Audits" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="Commissioner and admin history" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Schema ready" Foreground="#22C55E" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Cloudflare" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="D1, R2, Queues, Email, Pages" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Available" Foreground="#22C55E" FontWeight="Bold" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
